# Copy to backend/.env and adjust. backend/.env is git-ignored.
# NEVER put AWS access keys or other secrets in this file or in git.
# boto3 reads credentials from the standard AWS chain (env vars, ~/.aws, IAM role).

# --- Log ingestion ---
# Defaults to <repo>/data/app.log when unset. Docker Compose sets /data/app.log.
# LOG_FILE_PATH=../data/app.log
POLL_INTERVAL_SECONDS=1.0

# --- Sliding window / baseline ---
WINDOW_SIZE_SECONDS=60
BASELINE_WINDOW_COUNT=30

# --- Severity thresholds (anomaly score) ---
SEVERITY_LOW_THRESHOLD=2.0
SEVERITY_MEDIUM_THRESHOLD=3.0
SEVERITY_HIGH_THRESHOLD=4.0

# --- AWS ---
AWS_REGION=us-east-1
# Leave unset for real AWS. LocalStack: http://localhost:4566 (host)
# or http://localstack:4566 (Docker Compose).
# AWS_ENDPOINT_URL=http://localhost:4566

# --- CloudWatch ---
CLOUDWATCH_ENABLED=false
CLOUDWATCH_NAMESPACE=LogAnomalyDetector

# --- SNS ---
SNS_ENABLED=false
# Required when SNS_ENABLED=true.
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:log-anomaly-alerts
SNS_MIN_SEVERITY=HIGH
